{
    admin off
    auto_https disable_redirects
}

{$TINYAUTH_URL} {
    tls /etc/caddy/certs/localhost.pem /etc/caddy/certs/localhost-key.pem
    reverse_proxy tinyauth:3000
}

{$TOOLFRAME_URL} {
    tls /etc/caddy/certs/localhost.pem /etc/caddy/certs/localhost-key.pem
    reverse_proxy host.docker.internal:9876
}
